<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.nvhuong.tools</groupId>
    <artifactId>dev-workbench-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <!--
        Mô tả phân chia mô-đun cấp cao nhất:
        1. dev-workbench-foundation：Các khả năng cơ bản thấp nhất chỉ bao gồm các mô hình, hằng số và đường dẫn được chia sẻ.JSON、Hệ thống, cài đặt và cơ chế quốc tế hóa
        2. dev-workbench-request-core：Yêu cầu mô hình lõi đặc tả, chỉ đặt cấu hình yêu cầu,header/body/auth/protocol Chờ gì cả UI/Không có loại thực hiện vận chuyển
        3. dev-workbench-http-runtime：HTTP Chỉ cần đặt trong khi quá trình chuyển đang chạy PreparedRequest/HttpResponse、OkHttp/SSL/SSE/Cookie/redirect và các cổng trung tính
        4. dev-workbench-collection-core：Mô hình miền bộ sưu tập và DevWorkbench collection Để phân tích cú pháp, chỉ cần không đặt gì cả UI/Khả năng cốt lõi tổng hợp mà không cần chuỗi thực thi
        5. dev-workbench-mock-core：địa phương Mock Server Tuyến đường phù hợp,JDK HTTP Thời gian chạy, trạng thái phiên và nhật ký cuộc gọi
        6. dev-workbench-plugin-api：Giao diện tiện ích mở rộng ổn định, chỉ đặt những thứ công khai mà plug-in có thể dựa vào SPI Hợp đồng với dịch vụ plug-in
        7. dev-workbench-platform：Khả năng khung nền tảng máy chủ, hiện đang chấp nhận tùy chỉnh IOC Các vùng chứa và lõi cập nhật được phát hiện và sau đó được khởi tạo/Chào mừng/Thiết lập sự sắp xếp
        8. dev-workbench-performance-core：Kế hoạch kiểm tra căng thẳng và trạng thái chạy plan.json、Điều phối hoạt động, thống kê, v.v. Không có UI/Năng lực cốt lõi được thực hiện mà không cần truyền tải
        9. dev-workbench-ui：Được chia sẻ bởi máy chủ và các plug-in UI Các thành phần, kiểu dáng và công cụ trực quan cơ bản
        10. dev-workbench-plugin-runtime：Quét plug-in, tải, khởi động và dừng cũng như duy trì trạng thái
        11. dev-workbench-mcp：MCP stdio Thỏa thuận,tool schema và chủ nhà backend hợp đồng
        12. dev-workbench-plugins：Thư mục tổng hợp plugin chính thức, mỗi thư mục plugin-* Đóng gói và phát hành độc lập
        13. dev-workbench-app：Ứng dụng máy chủ chỉ giữ lại lối vào kết hợp, các trang cụ thể và các điểm truy cập máy chủ plug-in
     -->
    <modules>
        <module>dev-workbench-foundation</module>
        <module>dev-workbench-request-core</module>
        <module>dev-workbench-http-runtime</module>
        <module>dev-workbench-collection-core</module>
        <module>dev-workbench-mock-core</module>
        <module>dev-workbench-plugin-api</module>
        <module>dev-workbench-platform</module>
        <module>dev-workbench-performance-core</module>
        <module>dev-workbench-ui</module>
        <module>dev-workbench-plugin-runtime</module>
        <module>dev-workbench-mcp</module>
        <module>dev-workbench-plugins</module>
        <module>dev-workbench-app</module>
    </modules>

    <properties>
        <!--
            Mục nhập phiên bản máy chủ.
            app / runtime / api / manager Đợi lớp nền tảng theo sau ${revision}。
            plugin-* Không theo dõi ở đây để tự động nâng cấp mà ở mỗi cái pom.xml Phiên bản được duy trì riêng biệt.
            Bạn có thể nhấn nó sau“Bất kỳ plug-in nào đã được thay đổi thì chỉ có plug-in đó mới được phát hành”Việc phát hành nhịp điệu độc lập.
         -->
        <revision>6.3.3</revision>
        <!--
            Phiên bản tương thích với nền tảng plug-in.
            Nó thể hiện“plugin SPI / Ranh giới lắp ráp thời gian chạy”，Không giống như chủ nhà revision。
            Phiên bản này chỉ cần được nâng cấp khi cơ chế plug-in trải qua những thay đổi không tương thích.
         -->
        <plugin.platform.version>4.0.0</plugin.platform.version>
        <!-- Trang chủ mặc định của plugin chính thức được cung cấp descriptor Các mẫu được tái sử dụng một cách thống nhất. -->
        <plugin.homepage>https://github.com/nvhuong/dev-workbench</plugin.homepage>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ssXXX</maven.build.timestamp.format>
        <mainClass>com.nvhuong.devworkbench.App</mainClass>

        <!-- UI / core Phiên bản phụ thuộc cơ bản -->
        <flatlaf.version>3.7.2</flatlaf.version>
        <miglayout.version>11.4.3</miglayout.version>
        <hutool.version>5.8.47</hutool.version>
        <logback-classic.version>1.6.3</logback-classic.version>
        <jfreechart.version>1.5.5</jfreechart.version>
        <okhttp.version>5.5.0</okhttp.version>
        <kafka.version>3.9.2</kafka.version>
        <polyglot.version>24.2.1</polyglot.version>
        <org.eclipse.jgit.version>7.3.0.202506031305-r</org.eclipse.jgit.version>
        <!-- Keep Jackson aligned with the official MCP Java SDK JSON provider. -->
        <jackson.version>3.1.4</jackson.version>
        <mcp.version>2.0.1</mcp.version>
        <lombok.version>1.18.48</lombok.version>
        <twelvemonkeys.version>3.15.0</twelvemonkeys.version>
        <!-- Keep the Kotlin runtime aligned with OkHttp 5.5.0. -->
        <kotlin.version>2.1.21</kotlin.version>
        <rsyntaxtextarea.version>4.0.1</rsyntaxtextarea.version>
        <autocomplete.version>3.3.2</autocomplete.version>
        <slf4j.version>2.0.17</slf4j.version>
        <testng.version>7.12.0</testng.version>
        <jedis.version>5.2.0</jedis.version>
        <cfr.version>0.152</cfr.version>

        <maven.compiler.plugin.version>3.11.0</maven.compiler.plugin.version>
        <maven.jar.plugin.version>3.4.2</maven.jar.plugin.version>
        <maven.resources.plugin.version>3.4.0</maven.resources.plugin.version>
        <maven.shade.plugin.version>3.6.2</maven.shade.plugin.version>
        <maven.surefire.plugin.version>3.2.5</maven.surefire.plugin.version>
    </properties>

    <dependencyManagement>
        <!--
            Quản lý thống nhất các phiên bản phụ thuộc công khai tránh trùng lặp số phiên bản cho từng mô-đun phụ.
            Ở đây chúng tôi chủ yếu đặt các thư viện được lớp nền tảng và nhiều plugin sử dụng lại.
         -->
        <dependencies>
            <dependency>
                <groupId>com.formdev</groupId>
                <artifactId>flatlaf</artifactId>
                <version>${flatlaf.version}</version>
            </dependency>
            <dependency>
                <groupId>com.formdev</groupId>
                <artifactId>flatlaf-extras</artifactId>
                <version>${flatlaf.version}</version>
            </dependency>
            <dependency>
                <groupId>com.miglayout</groupId>
                <artifactId>miglayout-swing</artifactId>
                <version>${miglayout.version}</version>
            </dependency>
            <dependency>
                <groupId>tools.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>io.modelcontextprotocol.sdk</groupId>
                <artifactId>mcp</artifactId>
                <version>${mcp.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${logback-classic.version}</version>
            </dependency>
            <dependency>
                <groupId>org.graalvm.polyglot</groupId>
                <artifactId>polyglot</artifactId>
                <version>${polyglot.version}</version>
            </dependency>
            <dependency>
                <groupId>org.graalvm.polyglot</groupId>
                <artifactId>js</artifactId>
                <version>${polyglot.version}</version>
                <type>pom</type>
            </dependency>
            <dependency>
                <groupId>org.graalvm.polyglot</groupId>
                <artifactId>js-community</artifactId>
                <version>${polyglot.version}</version>
                <type>pom</type>
            </dependency>
            <dependency>
                <groupId>org.graalvm.regex</groupId>
                <artifactId>regex</artifactId>
                <version>${polyglot.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fifesoft</groupId>
                <artifactId>rsyntaxtextarea</artifactId>
                <version>${rsyntaxtextarea.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fifesoft</groupId>
                <artifactId>autocomplete</artifactId>
                <version>${autocomplete.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testng</groupId>
                <artifactId>testng</artifactId>
                <version>${testng.version}</version>
            </dependency>
            <dependency>
                <groupId>redis.clients</groupId>
                <artifactId>jedis</artifactId>
                <version>${jedis.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib</artifactId>
                <version>${kotlin.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib-common</artifactId>
                <version>${kotlin.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib-jdk7</artifactId>
                <version>${kotlin.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib-jdk8</artifactId>
                <version>${kotlin.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <!-- thống nhất Maven Phiên bản plug-in và cấu hình mặc định, các mô-đun con kế thừa khi cần -->
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <proc>full</proc>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven.jar.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven.resources.plugin.version}</version>
                    <configuration>
                        <encoding>UTF-8</encoding>
                        <propertiesEncoding>UTF-8</propertiesEncoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven.shade.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.plugin.version}</version>
                    <configuration>
                        <systemPropertyVariables>
                            <!-- Các mô-đun có triển khai ghi nhật ký không liên kết sẽ không xuất ra trong quá trình thử nghiệm SLF4J NOP gợi ý -->
                            <slf4j.internal.verbosity>ERROR</slf4j.internal.verbosity>
                            <!-- bình thường JDK chạy tiếp GraalJS Cảnh báo chế độ phiên dịch không được đưa ra trong quá trình thử nghiệm -->
                            <polyglot.engine.WarnInterpreterOnly>false</polyglot.engine.WarnInterpreterOnly>
                            <!-- Dữ liệu thử nghiệm được cách ly target，Tránh viết lại những gì nhà phát triển thực sự đã nói ~/DevWorkbench cấu hình -->
                            <user.home>${project.build.directory}/test-home</user.home>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <repositories>
        <!-- Phản chiếu trong nước làm giảm khả năng xảy ra lỗi tải xuống phụ thuộc -->
        <repository>
            <id>Aliyun-repository</id>
            <url>https://maven.aliyun.com/repository/public</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <pluginRepositories>
        <!-- Maven Phân tích plug-in cũng sử dụng phản chiếu trong nước -->
        <pluginRepository>
            <id>Aliyun-pluginRepository</id>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>
</project>
